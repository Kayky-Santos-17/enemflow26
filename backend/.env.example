# =============================================
#   EnemFlow AI — Variáveis de Ambiente
#   Copie este arquivo para .env e preencha
# =============================================

# === SERVIDOR ===
PORT=3000
NODE_ENV=development

# === BANCO DE DADOS ===
# Local:
MONGO_URI=mongodb://localhost:27017/enemflow
# Atlas (produção):
# MONGO_URI=mongodb+srv://<usuario>:<senha>@cluster.mongodb.net/enemflow?retryWrites=true&w=majority

# === JWT ===
JWT_SECRET=sua_chave_secreta_aqui_minimo_32_caracteres
JWT_EXPIRES_IN=7d

# === OPENROUTER (IA) ===
OPENROUTER_KEY=sk-or-v1-sua_chave_aqui
OPENROUTER_MODEL=openai/gpt-4.1-nano
OPENROUTER_TIMEOUT_MS=60000

# === CORS ===
FRONTEND_URL=http://localhost:5500
